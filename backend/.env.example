# Copy this file to .env and fill in your own values
SECRET_KEY=replace-this-with-a-long-random-string

# --- Database ---
# Default: SQLite, zero setup, good for local dev and small deployments.
DATABASE_URL=sqlite:///./app.db

# To use MySQL instead, comment out the line above and uncomment/edit this one.
# See the "MySQL Setup" section in the README for the full step-by-step guide.
# DATABASE_URL=mysql+pymysql://service_health_user:your-password@localhost:3306/service_health_dashboard

# --- ServiceNow integration ---
# See the "ServiceNow Integration" section in the README for the full setup
# guide. Leave SERVICENOW_INSTANCE_URL blank to keep the integration
# disabled - every /servicenow/* endpoint checks this first.
SERVICENOW_INSTANCE_URL=https://dev375971.service-now.com
SERVICENOW_TABLE=incident

# OAuth 2.0 is the default and recommended mode. "basic" is available for
# quick local testing only - switch back to "oauth" before pointing this
# at anything shared or production-facing.
SERVICENOW_AUTH_MODE=oauth

# Used when SERVICENOW_AUTH_MODE=oauth. Create these under System OAuth >
# Application Registry on the instance first (see README) - use "Create an
# OAuth API endpoint for external clients", then copy the generated
# values here. Never commit real values.
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=

# Needed for both auth modes: OAuth's password grant still authenticates as
# a real ServiceNow user (ideally a dedicated integration account with the
# x_yourco_snhealth.integration role from the Fluent app, not a personal
# admin login). Also used directly when SERVICENOW_AUTH_MODE=basic. Never
# commit real values.
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
